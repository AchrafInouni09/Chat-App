{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": "-- Grafana --",
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "editable": true,
    "gnetId": null,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "panels": [
        {
            "title": "Service Health (Up/Down)",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
            "targets": [
                {
                    "expr": "up",
                    "legendFormat": "{{job}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 },
                    "mappings": [
                        { "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }
                    ],
                    "max": 1,
                    "min": 0,
                    "thresholds": {
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    }
                }
            }
        },
        {
            "title": "Memory Usage (All Services)",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
            "targets": [
                {
                    "expr": "chatapp_auth_process_resident_memory_bytes",
                    "legendFormat": "auth-service"
                },
                {
                    "expr": "chatapp_user_process_resident_memory_bytes",
                    "legendFormat": "user-service"
                },
                {
                    "expr": "chatapp_chat_process_resident_memory_bytes",
                    "legendFormat": "chat-service"
                },
                {
                    "expr": "chatapp_post_process_resident_memory_bytes",
                    "legendFormat": "post-service"
                },
                {
                    "expr": "chatapp_friend_process_resident_memory_bytes",
                    "legendFormat": "friend-service"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 },
                    "unit": "bytes"
                }
            }
        },
        {
            "title": "CPU Usage (All Services)",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
            "targets": [
                {
                    "expr": "rate(chatapp_auth_process_cpu_user_seconds_total[5m])",
                    "legendFormat": "auth-service"
                },
                {
                    "expr": "rate(chatapp_user_process_cpu_user_seconds_total[5m])",
                    "legendFormat": "user-service"
                },
                {
                    "expr": "rate(chatapp_chat_process_cpu_user_seconds_total[5m])",
                    "legendFormat": "chat-service"
                },
                {
                    "expr": "rate(chatapp_post_process_cpu_user_seconds_total[5m])",
                    "legendFormat": "post-service"
                },
                {
                    "expr": "rate(chatapp_friend_process_cpu_user_seconds_total[5m])",
                    "legendFormat": "friend-service"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 },
                    "unit": "percentunit"
                }
            }
        },
        {
            "title": "MySQL Connections",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
            "targets": [
                {
                    "expr": "mysql_global_status_threads_connected",
                    "legendFormat": "Connected Threads"
                },
                {
                    "expr": "mysql_global_status_threads_running",
                    "legendFormat": "Running Threads"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 }
                }
            }
        },
        {
            "title": "Node CPU Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
            "targets": [
                {
                    "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
                    "legendFormat": "CPU Usage %"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 },
                    "unit": "percent",
                    "max": 100,
                    "min": 0
                }
            }
        },
        {
            "title": "Node Memory Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
            "targets": [
                {
                    "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
                    "legendFormat": "Used Memory"
                },
                {
                    "expr": "node_memory_MemTotal_bytes",
                    "legendFormat": "Total Memory"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 },
                    "unit": "bytes"
                }
            }
        },
        {
            "title": "Container CPU Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
            "targets": [
                {
                    "expr": "rate(container_cpu_usage_seconds_total{name=~\"chatapp-.*\"}[5m])",
                    "legendFormat": "{{name}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 },
                    "unit": "percentunit"
                }
            }
        },
        {
            "title": "Container Memory Usage",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
            "targets": [
                {
                    "expr": "container_memory_usage_bytes{name=~\"chatapp-.*\"}",
                    "legendFormat": "{{name}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": { "lineWidth": 2, "fillOpacity": 10 },
                    "unit": "bytes"
                }
            }
        }
    ],
    "schemaVersion": 30,
    "style": "dark",
    "tags": ["chatapp", "microservices"],
    "templating": { "list": [] },
    "time": { "from": "now-1h", "to": "now" },
    "timepicker": {},
    "timezone": "",
    "title": "ChatApp Microservices Dashboard",
    "uid": "chatapp-main",
    "version": 1
}

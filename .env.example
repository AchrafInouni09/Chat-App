# Docker Compose Environment Variables
# Copy this file to .env and replace with your actual values
# Command: cp .env.example .env

# ============================================
# MySQL Database Configuration
# ============================================
DB_NAME=chat_app
DB_USER=chat
# CHANGE THIS: Use a strong password (min 16 chars, mix of letters, numbers, symbols)
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
# CHANGE THIS: Root password should be different from DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_SECURE_ROOT_PASSWORD

# ============================================
# JWT Configuration
# ============================================
# CHANGE THIS: Generate with: openssl rand -base64 64
# This secret is used to sign and verify JWT tokens
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_SECRET

# ============================================
# Grafana Configuration
# ============================================
# CHANGE THIS: Admin password for Grafana dashboard access
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_TO_GRAFANA_PASSWORD

# ============================================
# Security Notes
# ============================================
# 1. NEVER commit .env to version control
# 2. Use different passwords for each service
# 3. Generate strong passwords: openssl rand -base64 32
# 4. Generate JWT secret: openssl rand -base64 64
# 5. Change all passwords in production environments
# 6. Backup this file securely after configuration
